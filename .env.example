# ComplianceOS AI — environment template
# Copy to .env and fill values. Never commit real secrets.

# App
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://complianceos:complianceos@localhost:5432/complianceos

# Auth / JWT
AUTH_SECRET=dev-insecure-secret-change-me
AUTH_ISSUER=complianceos-ai
JWT_AUDIENCE=complianceos-ai-client
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# Features
ENABLE_REGISTRATION=true

# SMTP (optional; token-based reset wired, email send is a no-op in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@complianceos.ai

# Frontend (consumed by Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
